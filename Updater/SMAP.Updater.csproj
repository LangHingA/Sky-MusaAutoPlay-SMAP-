<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SMAP.Updater</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/SMAP.WPF/Updates/UpdateManifest.cs" Link="UpdateManifest.cs" />
    <Compile Include="../src/SMAP.WPF/Updates/ContentChunks.cs" Link="ContentChunks.cs" />
    <Compile Include="../src/SMAP.WPF/Updates/UpdatePlan.cs" Link="UpdatePlan.cs" />
    <Compile Include="../src/SMAP.WPF/Updates/UpdateTransaction.cs" Link="UpdateTransaction.cs" />
    <Compile Include="../src/SMAP.WPF/Updates/UpdateTrust.cs" Link="UpdateTrust.cs" />
    <Compile Include="../src/SMAP.WPF/Updates/UpdateHealth.cs" Link="UpdateHealth.cs" />
    <Compile Include="../src/SMAP.WPF/Updates/UpdateVersions.cs" Link="UpdateVersions.cs" />
    <Compile Include="../src/SMAP.WPF/Updates/LegacyProgramInventory.cs" Link="LegacyProgramInventory.cs" />
    <EmbeddedResource Include="../src/SMAP.WPF/Assets/LegacyLayouts/managed-files.json" LogicalName="SMAP.LegacyProgramFiles.json" />
  </ItemGroup>
</Project>
